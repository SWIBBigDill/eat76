# Eat76 — Stripe (platform account). Copy to .env.local; never commit real keys.
# Full setup guide: docs/STRIPE_SETUP.md

# Platform secret key (test: sk_test_..., live: sk_live_...). Prefer restricted key (rk_) in production.
STRIPE_SECRET_KEY=

# Publishable key for client-side Stripe detection (test: pk_test_...)
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret from Dashboard or `stripe listen`
STRIPE_WEBHOOK_SECRET=

# Optional: canonical app URL for Checkout return URLs (defaults to request Origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: set to false to force demo checkout/payouts even when keys are present
# NEXT_PUBLIC_STRIPE_ENABLED=false

# Supabase (project dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key for elevated server access (bypasses RLS). Keep server-only.
SUPABASE_SECRET_KEY=

# Email notifications via Resend (optional)
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=orders@eat76.com

# Google Maps + Places (optional). Create a key in Google Cloud Console
# (console.cloud.google.com > APIs & Services > Credentials) and enable the
# Maps Embed API, Maps JavaScript API, and Places API for it.
# Without this key, maps use OpenStreetMap and address inputs stay plain text.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Analytics 4 (optional). Measurement ID like G-XXXXXXXXXX from
# analytics.google.com > Admin > Data Streams. Without it no analytics load.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google sign-in needs no env var here: enable the Google provider in the
# Supabase dashboard (Authentication > Providers) with an OAuth client ID and
# secret from Google Cloud Console. The button appears once Supabase is set.
